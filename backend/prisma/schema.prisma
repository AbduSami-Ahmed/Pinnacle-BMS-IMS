datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  ON_ORDER
}

enum OrderStatus {
  AWAITING_PICK
  PACKING
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum Priority {
  URGENT
  NORMAL
  SCHEDULED
}

enum LeadStatus {
  NEEDS_QUOTE
  FITMENT_VERIFICATION
  FOLLOW_UP_REQUIRED
  QUOTED
  CLOSED
}

enum ChannelStatus {
  HEALTHY
  SYNCING
  NEEDS_ATTENTION
}

model Category {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  parts     Part[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Part {
  id             String      @id @default(uuid())
  sku            String      @unique
  oemNumber      String
  name           String
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id])
  vehicleFitment String
  binLocation    String
  onHand         Int         @default(0)
  minThreshold   Int         @default(5)
  reorderPoint   Int         @default(10)
  unitCost       Decimal     @db.Decimal(10, 2)
  retailPrice    Decimal     @db.Decimal(10, 2)
  supplier       String
  status         StockStatus @default(IN_STOCK)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Customer {
  id            String   @id @default(uuid())
  accountNumber String   @unique
  businessName  String
  contactName   String
  phone         String
  email         String?
  pricingTier   String   @default("Wholesale")
  creditLimit   Decimal  @default(0.0) @db.Decimal(10, 2)
  creditBalance Decimal  @default(0.0) @db.Decimal(10, 2)
  orders        Order[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id])
  status       OrderStatus @default(AWAITING_PICK)
  priority     Priority    @default(NORMAL)
  totalAmount  Decimal     @db.Decimal(10, 2)
  vehicleNote  String?
  items        OrderItem[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partId    String
  part      Part     @relation(fields: [partId], references: [id])
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
}

model Lead {
  id             String     @id @default(uuid())
  contactName    String
  companyName    String?
  phone          String
  email          String?
  source         String
  partRequested  String
  vehicleDetails String
  urgency        String     @default("Standard")
  status         LeadStatus @default(NEEDS_QUOTE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model SalesChannel {
  id           String        @id @default(uuid())
  name         String        @unique
  channelType  String
  status       ChannelStatus @default(HEALTHY)
  lastSync     String
  ordersToday  Int           @default(0)
  revenueToday Decimal       @default(0.0) @db.Decimal(10, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}
